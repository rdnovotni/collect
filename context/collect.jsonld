{
  "@context": {
    "@version": 1.1,
    "collect": "https://raw.githubusercontent.com/rdnovotni/collect/main/context/terms#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "id": "@id",
    "layer": "collect:layer",
    "category": "collect:category",
    "title": "schema:name",
    "description": "schema:description",
    "date": "dcterms:date",
    "tags": "schema:keywords",
    "notes": "schema:comment",
    "work": { "@id": "schema:exampleOfWork", "@type": "@id" },
    "instanceOf": { "@id": "collect:instanceOf", "@type": "@id" },
    "variantOf": { "@id": "schema:isVariantOf", "@type": "@id" },
    "number": "schema:position",
    "agents": "dcterms:contributor",
    "identifiers": "schema:identifier",
    "places": "schema:spatialCoverage",
    "images": "schema:image",
    "sources": "dcterms:source",
    "relationships": "dcterms:relation",
    "entries": "schema:hasPart",
    "ref": { "@id": "@id", "@type": "@id" },
    "role": "collect:role",
    "name": "schema:name",
    "scheme": "schema:propertyID",
    "value": "schema:value",
    "wikidata": "collect:wikidata",
    "rights": "dcterms:rights",
    "license": "schema:license",
    "postcard": "https://raw.githubusercontent.com/rdnovotni/collect/main/profiles/postcard/terms#"
  }
}
